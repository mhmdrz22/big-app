APP_ENV=development
PORT=8000
MODEL_DIR=model
DATABASE_URL=sqlite:///instance/stress_sentinel_local.db
STORE_TEXT_BY_DEFAULT=false
LOW_RISK_THRESHOLD=0.35
HIGH_RISK_THRESHOLD=0.60
DECISION_THRESHOLD=0.48
ANALYZE_RATE_LIMIT_PER_MIN=20
FEEDBACK_RATE_LIMIT_PER_MIN=30
AUTH_SECRET=local-development-secret-key-please-change-if-needed-12345
AUTH_ALGORITHM=HS256
ACCESS_TOKEN_EXP_MINUTES=120
BOOTSTRAP_ADMIN_ENABLED=true
BASELINE_TRAIN_PATH=data/dreaddit-train.csv
BASELINE_TEST_PATH=data/dreaddit-test.csv
RETRAINING_DIR=model/retraining_runs
MIN_APPROVED_FEEDBACK_FOR_RETRAINING=5
WORKER_POLL_SECONDS=5
WORKER_NAME=stress-worker-1
MAX_JOB_ATTEMPTS=3
