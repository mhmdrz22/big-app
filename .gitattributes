# Auto detect text files and perform LF normalization
* text=auto

# Force LF for shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Force CRLF for Windows batch
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.joblib binary
*.bin binary
*.pt binary
*.pth binary
*.h5 binary
*.db binary
*.sqlite binary
*.zip binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary

